# Copy this file to .env and adjust as needed.
# These are starting values, not guaranteed-optimal settings.

MODEL_NAME=models/yolo26n.pt

DETECTION_CONFIDENCE=0.25
IOU_THRESHOLD=0.70
IMAGE_SIZE=640

TRACKER=bytetrack.yaml
TRAJECTORY_LENGTH=30

# Counting line, as (x_ratio,y_ratio) of frame width/height.
# Default is VERTICAL (down the middle) -- correct for footage where
# objects move left-right across the frame. If your footage shows
# objects moving toward/away from the camera instead, use a horizontal
# line: COUNTING_LINE_START_RATIO=[0.0, 0.5] / END_RATIO=[1.0, 0.5].
# The line must be roughly perpendicular to the actual direction of
# motion, or nothing will ever register as a crossing.
COUNTING_LINE_START_RATIO=[0.5, 0.0]
COUNTING_LINE_END_RATIO=[0.5, 1.0]
COUNTING_ENABLED_DEFAULT=true

MAX_UPLOAD_SIZE_MB=100
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs

CORS_ALLOW_ORIGINS=["http://localhost:5173"]
